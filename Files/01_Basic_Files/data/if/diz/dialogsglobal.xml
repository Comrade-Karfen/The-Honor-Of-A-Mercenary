		role="PLAYER"
		scriptResult="EndConversation()" />
<!--Root/demo/Второстепенные/Какой-то мужик-->
	<Reply
		name="Dlg_npc_000085"
		text="Здравствуй, путник. Можешь помочь с одним делом?"
		role="NPC"
		scriptCondition="IsQuestComplete('demo_MoveToGhostTown_Quest') and GetCurNpc():GetSpokenCount() == 0"
		nextReplies="Dlg_pl_000086" />

	<Reply
		name="Dlg_pl_000086"
		text="Приветствую. Что тебе нужно?"
		role="PLAYER"
		nextReplies="Dlg_npc_000087" />

	<Reply
		name="Dlg_npc_000087"
		text="Меня на днях обокрали одни сволочи. Недавно я узнал, что они обосновались неподалёку, к северо-западу от посёлка. Помоги мне с ними разобраться, а я тебе неплохо заплачу."
		role="NPC"
		nextReplies="Dlg_pl_000091 Dlg_pl_000090 Dlg_pl_000135" />

	<Reply
		name="Dlg_pl_000135"
		text="А что они украли-то?"
		role="PLAYER"
		nextReplies="Dlg_npc_000139" />

	<Reply
		name="Dlg_npc_000139"
		text="Да много чего. В основном всякий хлам. Единственное ценное из того, что они утащили, это ящик моей особой ананаги. Взяли и вывезли ночью, пока я спал. Ну так что, поможешь?"
		role="NPC"
		nextReplies="Dlg_pl_000141 Dlg_pl_000151" />

	<Reply
		name="Dlg_pl_000151"
		text="Знаешь, разбирайся сам со своими проблемами. "
		role="PLAYER"
		scriptResult="GetCurNpc():SetSpokenCount(1);  EndConversation() " />

	<Reply
		name="Dlg_pl_000141"
		text="Хорошо, я помогу тебе с этим делом. "
		role="PLAYER"
		scriptResult="TakeQuest( 'demo_new_KillBandits_Quest' ); TActivate( 'QUEST_BANDITS' ); GetCurNpc():SetSpokenCount(1); EndConversation() " />

	<Reply
		name="Dlg_pl_000091"
		text="Хмм… Звучит не сложно, я согласен. "
		role="PLAYER"
		scriptResult="TakeQuest( 'demo_new_KillBandits_Quest' ); TActivate( 'QUEST_BANDITS' ); GetCurNpc():SetSpokenCount(1); EndConversation()" />

	<Reply
		name="Dlg_pl_000090"
		text="У меня нет на это времени. "
		role="PLAYER"
		scriptResult="GetCurNpc():SetSpokenCount(1);  EndConversation()" />
<!--Root/demo/Второстепенные/Кто-то-->
	<Reply
		name="Dlg_npc_000160"
		text="А? Ты кто таков? Чего ты здесь делаешь?"
		role="NPC"
		scriptCondition="IsQuestComplete('demo_MoveToGhostTown_Quest') and GetCurNpc():GetSpokenCount() == 0 "
		nextReplies="Dlg_pl_000170 Dlg_pl_000196 Dlg_pl_000197 Dlg_pl_000211" />

	<Reply
		name="Dlg_pl_000211"
		text="Ты, как я вижу, механик? Не знаешь, где можно раздобыть хорошее оружие?"
		role="PLAYER"
		scriptCondition="IsQuestTaken( 'demo_FindBigGun_Quest' )   and   not(IsQuestComplete('demo_FindSklad_Quest')) "
		nextReplies="Dlg_npc_000212" />

	<Reply
		name="Dlg_npc_000212"
		text="Хмм… В рыбацких деревнях ты вряд ли что-то сможешь найти, так что советую заглянуть на рынок в Ольме. Также на холме, к юго-востоку от Кордана вроде как был некий старый склад, но ключей от него ни у кого нет."
		role="NPC"
		nextReplies="Dlg_pl_000213" />

	<Reply
		name="Dlg_pl_000213"
		text="Понял. Спасибо за помощь."
		role="PLAYER"
		scriptResult="CompleteQuest('demo_FindSklad_Quest')"
		nextReplies="Dlg_npc_000217" />

	<Reply
		name="Dlg_npc_000217"
		text="Погоди, не хочешь немного подзаработать?"
		role="NPC"
		nextReplies="Dlg_pl_000199 Dlg_pl_000202" />

	<Reply
		name="Dlg_pl_000170"
		text="Да я просто мимо проходил."
		role="PLAYER"
		nextReplies="Dlg_npc_000182" />

	<Reply
		name="Dlg_npc_000182"
		text="Ну-ну. Хм… Странно как-то ты выглядишь. Не местный, что ли? А впрочем, не важно. Не желаешь немного подзаработать?"
		role="NPC"
		nextReplies="Dlg_pl_000199 Dlg_pl_000202" />

	<Reply
		name="Dlg_pl_000197"
		text="Ты, как я вижу, механик? Не знаешь, где я мог бы улучшить машину?"
		role="PLAYER"
		scriptCondition="IsQuestTaken( 'demo_FindWorkshop_Quest' )   and   not(IsQuestTaken( 'demo_GetMoney_Quest')) "
		nextReplies="Dlg_npc_000191" />

	<Reply
		name="Dlg_npc_000191"
		text="Ну что за вопросы - в Ольме, конечно. Ты не местный, что ли? А впрочем, не важно. Хм… Кстати, не желаешь немного подзаработать? "
		role="NPC"
		nextReplies="Dlg_pl_000199 Dlg_pl_000202" />

	<Reply
		name="Dlg_pl_000196"
		text="Ваш посёлок вроде относительно недалеко от руин находится? Я недавно видел свечение над ними. Не знаешь, что там случилось?"
		role="PLAYER"
		scriptCondition="IsQuestTaken( 'demo_FindSvidetel1_Quest' )    and   not(IsQuestTaken( 'demo_GiveSvidetelmoney15K_Quest'))   and   not(IsQuestTaken( 'demo_GiveSvidetelmoney20K_Quest'))  "
		nextReplies="Dlg_npc_000198" />

	<Reply
		name="Dlg_npc_000198"
		text="О, я так понимаю, ты не местный? Местным давно уже безразлично то, что в чёртовом городе творится. И мне тоже плевать, какая там ахинея происходит. Всё, а теперь иди куда шёл, не мешай мне работать. Хотя… Слушай, не поможешь мне с одним дельцем?"
		role="NPC"
		nextReplies="Dlg_pl_000199 Dlg_pl_000202" />

	<Reply
		name="Dlg_pl_000202"
		text="Нет, мне сейчас не до этого."
		role="PLAYER"
		scriptResult="GetCurNpc():SetSpokenCount(2); EndConversation()" />

	<Reply
		name="Dlg_pl_000199"
		text="Смотря что от меня требуется."
		role="PLAYER"
		nextReplies="Dlg_npc_000200" />

	<Reply
		name="Dlg_npc_000200"
		text="О, да всего лишь найти и доставить мне одно устройство. Магнитный ускоритель, если говорить точнее. Вещица редкая, но нужная. Не беспокойся, награда будет соответствующая."
		role="NPC"
		nextReplies="Dlg_pl_000201 Dlg_pl_000204 Dlg_pl_000205" />

	<Reply
		name="Dlg_pl_000205"
		text="У меня нет времени на поиски всякого хлама."
		role="PLAYER"
		scriptResult="GetCurNpc():SetSpokenCount(2); EndConversation() " />

	<Reply
		name="Dlg_pl_000204"
		text="Хорошо, попробую найти."
		role="PLAYER"
		scriptResult="TakeQuest( 'demo_new_FindDetail_Quest' ); GetCurNpc():SetSpokenCount(1); EndConversation() " />

	<Reply
		name="Dlg_pl_000201"
		text="Хм… Магнитный ускоритель, говоришь? Такой? [Отдать магнитный ускоритель]"
		role="PLAYER"
		scriptCondition="HasPlayerAmountOfItems('firing_range_guns')"
		scriptResult="TakeQuest( 'demo_new_FindDetail_Quest' ); RemoveItemsFromPlayerRepository('firing_range_guns'); CompleteQuest('demo_new_FindDetail_Quest'); GetCurNpc():SetSpokenCount(2)"
		nextReplies="Dlg_npc_000195" />

	<Reply
		name="Dlg_npc_000195"
		text="Да-да, это именно то, что нужно. Награду деньгами возьмёшь или лучше дать тебе неплохих деталей для автомобиля?"
		role="NPC"
		nextReplies="Dlg_pl_000203 Dlg_pl_000206" />

	<Reply
		name="Dlg_pl_000206"
		text="Детали для автомобиля мне не помешают."
		role="PLAYER"
		scriptResult="SpawnItem('add_torque_and_stability'); EndConversation()" />

	<Reply
		name="Dlg_pl_000203"
		text="Давай деньгами."
		role="PLAYER"
		scriptResult="AddPlayerMoney( 1700 ); EndConversation()" />

	<Reply
		name="Dlg_npc_000207"
		text="Ну что, привёз?"
		role="NPC"
		scriptCondition="GetCurNpc():GetSpokenCount() == 1"
		nextReplies="Dlg_pl_000208 Dlg_pl_000209" />

	<Reply
		name="Dlg_pl_000209"
		text="Ещё нет."
		role="PLAYER"
		scriptResult="EndConversation()" />

	<Reply
		name="Dlg_pl_000208"
		text="Да, забирай своё устройство."
		role="PLAYER"
		scriptCondition="HasPlayerAmountOfItems('firing_range_guns') "
		scriptResult="CompleteQuest('demo_new_FindDetail_Quest'); RemoveItemsFromPlayerRepository('firing_range_guns'); GetCurNpc():SetSpokenCount(2)"
		nextReplies="Dlg_npc_000210" />

	<Reply
		name="Dlg_npc_000210"
		text="Хе-хе, отлично. Награду деньгами возьмёшь или лучше дать тебе неплохих деталей для автомобиля?"
		role="NPC"
		nextReplies="Dlg_pl_000203 Dlg_pl_000206" />
<!--Root/demo/Сюжетные/Диалог со стариком в деревне-->
	<Reply
		name="Ieri_hellodlg0"
		text="Очнулся? Я уж думал, что не придёшь в себя."
		role="NPC"
		scriptCondition="GetCurNpc():GetSpokenCount() == 0   and  IsQuestComplete('demo_MoveToGhostTown_Quest')"
		scriptResult="TActivate ('OlmeOpenGateToPlayer')"
		nextReplies="Dlg_pl_001267" />

	<Reply
		name="Dlg_pl_001267"
		text="Где я? Что случилось?"
		role="PLAYER"
		nextReplies="Dlg_npc_001268" />

	<Reply
		name="Dlg_npc_001268"
		text="Ты в моём доме. Я нашёл тебя без чувств недалеко от города-призрака."
		role="NPC"
		nextReplies="Dlg_pl_001269 Dlg_pl_001270" />

	<Reply
		name="Dlg_pl_001270"
		text="Ни черта не понимаю… Ехал себе спокойно, как вдруг…"
		role="PLAYER"
		nextReplies="Dlg_npc_001271" />

	<Reply
		name="Dlg_npc_001271"
		text="Так значит, ты был на машине… А я уж удивился, откуда пеший странник в нашем краю. Подумал было… А впрочем, не важно. Радуйся, что жив остался. А грузовичок-то мы тебе справим."
		role="NPC"
		nextReplies="Dlg_pl_001272 Dlg_pl_001273" />

	<Reply
		name="Dlg_pl_001273"
		text="Обойдусь без твоей помощи, старик."
		role="PLAYER"
		nextReplies="Dlg_npc_000118" />

	<Reply
		name="Dlg_npc_000118"
		text="Не отказывайся от помощи раньше времени. Без транспорта путешествовать опасно, возьми мой грузовичок."
		role="NPC"
		nextReplies="Dlg_pl_000119" />

	<Reply
		name="Dlg_pl_000119"
		text="Хм… Хорошо. Но я в долгу не останусь. Выполню задание и вернусь с наградой."
		role="PLAYER"
		nextReplies="Dlg_npc_000120" />

	<Reply
		name="Dlg_npc_000120"
		text="И куда же ты сейчас направишься?"
		role="NPC"
		nextReplies="Dlg_pl_000121" />

	<Reply
		name="Dlg_pl_000121"
		text="Пока точно не знаю. Для начала не помешало бы обзавестись грузовиком покрепче, да вооружиться как следует."
		role="PLAYER"
		nextReplies="Dlg_npc_000122" />

	<Reply
		name="Dlg_npc_000122"
		text="Советую поспрашивать насчёт этого в местном баре – там часто бывают люди, знающие толк в технике. Также я слышал, что к юго-востоку от Кордана есть старый склад, быть может, там сможешь что-нибудь найти. Более не смею задерживать тебя. Да сопутствует тебе удача в дороге."
		role="NPC"
		nextReplies="Dlg_pl_000123" />

	<Reply
		name="Dlg_pl_000123"
		text="Спасибо за помощь. До скорого."
		role="PLAYER"
		scriptResult="GetCurNpc():SetSpokenCount( 1 ); TakeQuest('demo_UpgradeCar_Quest'); GetWorkshopVehicles('Olme_Workshop'):AddItems('MolokovozForSale', 1) TActivate ('Trigger_FindUpgrade'); AddHistory( 'demo_AfterGhostTown1' ); AddFadingMsgId( 'fm_history_got' ); ShowCircleOnMinimap( 'demo', CVector(2653.222, 249.000, 1100.867), 100 ); EndConversation() " />

	<Reply
		name="Dlg_pl_001276"
		text="Хмм… Кто-то ведь явно стоит за тем, что произошло в городе. Я хочу найти того, кто провернул со мной эту злую шутку. Дело не только в пропавшем грузовике – задета моя честь! Что я могу сделать?"
		role="PLAYER"
		nextReplies="Dlg_npc_001281" />

	<Reply
		name="Dlg_npc_001281"
		text="Такое яркое событие не могло пройти незамеченным. Эта местность достаточно плотно населена. Наверняка были свидетели."
		role="NPC"
		nextReplies="Dlg_pl_001282" />

	<Reply
		name="Dlg_pl_001282"
		text="Что нам даст опрос свидетелей?"
		role="PLAYER"
		nextReplies="Dlg_npc_001283" />

	<Reply
		name="Dlg_npc_001283"
		text="Чем больше точек зрения, тем вернее информация."
		role="NPC"
		nextReplies="Dlg_pl_001284" />

	<Reply
		name="Dlg_pl_001284"
		text="Хмм… Звучит разумно. Хорошо, я всё выясню."
		role="PLAYER"
