		role="NPC"
		nextReplies="Dlg_pl_000138" />

	<Reply
		name="Dlg_pl_000138"
		text="Thanks."
		role="PLAYER"
		scriptResult=" EndConversation()" />
<!--Root/demo/Сюжетные/Свидетель в Калисе-->
	<Reply
		name="TankGirl_hellodlg0"
		text="Come in, we’re glad to see guests. What brings you to my house?"
		role="NPC"
		scriptCondition="IsQuestTaken('demo_FindSvidetel1_Quest')     and     not(IsQuestComplete('demo_FindSvidetel1_Quest'))"
		nextReplies="Dlg_pl_000142" />

	<Reply
		name="Dlg_pl_000142"
		text="I recently saw a glow above the ruins of the city. Do you know what happened there?"
		role="PLAYER"
		nextReplies="Dlg_npc_000143" />

	<Reply
		name="Dlg_npc_000143"
		text="So that’s how it is… Actually, people here aren’t very curious. Only I sometimes go wandering through the ruins. Sometimes I come across something interesting… But it’s a troublesome business – I get really tired…"
		role="NPC"
		nextReplies="Dlg_pl_000144 Dlg_pl_000145" />

	<Reply
		name="Dlg_pl_000145"
		text='I happen to have a good “fatigue remedy”…'
		role="PLAYER"
		scriptResult=" GetCurNpc():SetSpokenCount( 2 );  TakeQuest('demo_GiveSvidetelmoney15K_Quest');  CompleteQuest('demo_GiveSvidetelmoney20K_Quest');  CompleteQuest('demo_FindSvidetel1_Quest');"
		nextReplies="Dlg_npc_000147" />

	<Reply
		name="Dlg_npc_000147"
		text="Ha-ha! Looks like we’ll find common ground. For a modest fee of 5,000 coins, I’ll tell you everything I know."
		role="NPC"
		nextReplies="Dlg_pl_000153 Dlg_pl_000150 Dlg_pl_000148" />

	<Reply
		name="Dlg_pl_000148"
		text="That’s quite a price! Looks like I’ve got no choice. How can I get that much money?"
		role="PLAYER"
		scriptCondition="(GetPlayerMoney() < 5000   and   GetCurNpc():GetSpokenCount() == 2)   or  (GetPlayerMoney() < 6000   and   GetCurNpc():GetSpokenCount() == 1) "
		nextReplies="Dlg_npc_000149" />

	<Reply
		name="Dlg_npc_000149"
		text="People are richer than they seem, and they’re willing to pay a hefty sum if you help them."
		role="NPC"
		nextReplies="Dlg_pl_000150" />

	<Reply
		name="Dlg_pl_000150"
		text="Wait. I won’t be long."
		role="PLAYER"
		scriptResult=" EndConversation()" />

	<Reply
		name="Dlg_pl_000144"
		text="Go on, tell me what you saw!"
		role="PLAYER"
		scriptResult=" GetCurNpc():SetSpokenCount( 1 );  TakeQuest('demo_GiveSvidetelmoney20K_Quest');  CompleteQuest('demo_GiveSvidetelmoney15K_Quest');  CompleteQuest('demo_FindSvidetel1_Quest');"
		nextReplies="Dlg_npc_000146" />

	<Reply
		name="Dlg_npc_000146"
		text="What rudeness! I won’t say anything. However, 6,000 coins would be enough to change my attitude toward you. And know that no one else will tell you what I know!"
		role="NPC"
		nextReplies="Dlg_pl_000153 Dlg_pl_000150 Dlg_pl_000148" />

	<Reply
		name="TankGirl_hellodlg1"
		text="Did you bring it?"
		role="NPC"
		scriptCondition="(GetCurNpc():GetSpokenCount() > 0)   and   (3 > GetCurNpc():GetSpokenCount())"
		nextReplies="Dlg_pl_000153 Dlg_pl_000152" />

	<Reply
		name="Dlg_pl_000153"
		text="Here’s your money. Now tell me."
		role="PLAYER"
		scriptCondition="(GetPlayerMoney() >= 5000   and   GetCurNpc():GetSpokenCount() == 2)   or  (GetPlayerMoney() >= 6000   and   GetCurNpc():GetSpokenCount() == 1)"
		nextReplies="Dlg_npc_000154" />

	<Reply
		name="Dlg_npc_000154"
		text="Thank you. Mind if I count it? Trust, but verify."
		role="NPC"
		nextReplies="Dlg_pl_000155" />

	<Reply
		name="Dlg_pl_000155"
		text="Please do."
		role="PLAYER"
		nextReplies="Dlg_npc_000156" />

	<Reply
		name="Dlg_npc_000156"
		text="Hmm… Let’s see… Everything’s in order. Alright, listen to how it happened: I was walking nearby, collecting some shiny fragments. Then suddenly I see: a pillar of fire rises from the neighboring hill, higher and higher, and then crashes down onto the old city."
		role="NPC"
		nextReplies="Dlg_pl_000157" />

	<Reply
		name="Dlg_pl_000157"
		text="Can you point out exactly where that place was?"
		role="PLAYER"
		nextReplies="Dlg_npc_000158" />

	<Reply
		name="Dlg_npc_000158"
		text="Not sure. And it’s not about the money, don’t get me wrong. It’s just that everything in my memory is kind of blurry."
		role="NPC"
		nextReplies="Dlg_pl_000159" />

	<Reply
		name="Dlg_pl_000159"
		text="Thank you. I’ll keep looking."
		role="PLAYER"
		scriptResult="CompleteQuest('demo_GiveSvidetelmoney20K_Quest');  CompleteQuest('demo_GiveSvidetelmoney15K_Quest');  CompleteQuest('demo_Svidetel1_Quest');  if GetCurNpc():GetSpokenCount() == 1 then AddPlayerMoney( -6000 ) end;  if GetCurNpc():GetSpokenCount() == 2 then AddPlayerMoney( -5000 ) end;  GetCurNpc():SetSpokenCount( 3 );  TActivate ('TriggerMyFriends');  ShowCircleOnMinimap( 'demo', CVector(1663.391, 270.000, 1851.340), 100 );  EndConversation()" />

	<Reply
		name="Dlg_pl_000152"
		text="Not yet."
		role="PLAYER"
		scriptResult=" EndConversation()" />
<!--Root/demo/Сюжетные/Свидетель 2 в Кордане-->
	<Reply
		name="Knowman_hellodlg0"
		text="We’re not expecting anyone – you’d better leave this place ASAP."
		role="NPC"
		scriptCondition="IsQuestTaken('demo_FindSvidetel2_Quest')    and    not(IsQuestComplete('demo_FindSvidetel2_Quest'))"
		nextReplies="Dlg_pl_000161" />

	<Reply
		name="Dlg_pl_000161"
		text="Have you noticed anything strange near the ruins lately?"
		role="PLAYER"
		nextReplies="Dlg_npc_000162" />

	<Reply
		name="Dlg_npc_000162"
		text="No, who needs those ruins? Except maybe Sinx. He’s always hanging around there."
		role="NPC"
		nextReplies="Dlg_pl_000163" />

	<Reply
		name="Dlg_pl_000163"
		text="Who’s Sinx?"
		role="PLAYER"
		nextReplies="Dlg_npc_000164" />

	<Reply
		name="Dlg_npc_000164"
		text="He’s the local oddball. Wanders around, frightens people. Also begs for stuff. Nobody likes him here, but they tolerate him."
		role="NPC"
		nextReplies="Dlg_pl_000165" />

	<Reply
		name="Dlg_pl_000165"
		text="Where can I find him?"
		role="PLAYER"
		nextReplies="Dlg_npc_000166" />

	<Reply
		name="Dlg_npc_000166"
		text="Are you even listening? He’s a rolling stone. He hasn’t been around here for a long time. Although… I heard through the grapevine that local bandits recently took an interest in him, so he might be dead by now."
		role="NPC"
		nextReplies="Dlg_pl_000167" />

	<Reply
		name="Dlg_pl_000167"
		text="What bandits? Where can I look for them?"
		role="PLAYER"
		nextReplies="Dlg_npc_000168" />

	<Reply
		name="Dlg_npc_000168"
		text="At the abandoned warehouse, southeast of here."
		role="NPC"
		nextReplies="Dlg_pl_000169" />

	<Reply
		name="Dlg_pl_000169"
		text="Alright, I’ll check it out right now."
		role="PLAYER"
		scriptResult="CompleteQuest('demo_FindSvidetel2_Quest');  TActivate ('TriggerSkladSinks');  TDeactivate( 'TriggerMyFriends' );  ShowCircleOnMinimap( 'demo', CVector(915.998, 306.001, 2509.014), 100 );  EndConversation()" />
<!--Root/demo/Сюжетные/Синкс на складе-->
	<Reply
		name="Sinks_hellodlg0"
		text="You’re not with them? I thought you were a bandit, so I shot."
		role="NPC"
		scriptCondition="IsQuestTaken('demo_GetSinks_Quest')   and   not(IsQuestComplete('demo_GetSinks_Quest'))"
		nextReplies="Dlg_pl_000171" />

	<Reply
		name="Dlg_pl_000171"
		text="No, I’m on my own, Sinx. That’s your name, right? Tell me, have you seen anything strange lately – say, in the city ruins?"
		role="PLAYER"
		nextReplies="Dlg_npc_000172" />

	<Reply
		name="Dlg_npc_000172"
		text="Go away, demon! This knowledge was revealed only to me!"
		role="NPC"
		nextReplies="Dlg_pl_000173 Dlg_pl_000174" />

	<Reply
		name="Dlg_pl_000174"
		text="If you raise your voice at me again, you’ll be talking to real demons in hell! Tell me quickly – what did you see?"
		role="PLAYER"
		nextReplies="Dlg_npc_000176" />

	<Reply
		name="Dlg_npc_000176"
		text="Alright, alright, I’ll tell you everything. Voices called me to witness a miracle! I saw a rainbow streaking the sky with fiery bands. When the haze cleared, the city shone with unearthly colors. I haven’t fully grasped the meaning of this sign yet…"
		role="NPC"
		nextReplies="Dlg_pl_000177" />

	<Reply
		name="Dlg_pl_000177"
		text="So the end of the rainbow was over the city, I take it?"
		role="PLAYER"
		nextReplies="Dlg_npc_000178" />

	<Reply
		name="Dlg_npc_000178"
		text="Yes, that’s right."
		role="NPC"
		nextReplies="Dlg_pl_000179" />

	<Reply
		name="Dlg_pl_000179"
		text="Where was the other end?"
		role="PLAYER"
		nextReplies="Dlg_npc_000180" />

	<Reply
		name="Dlg_npc_000180"
		text="It stretched out from beyond the hills."
		role="NPC"
		nextReplies="Dlg_pl_000181" />

	<Reply
		name="Dlg_pl_000181"
		text="Got it! I understand now."
		role="PLAYER"
		scriptResult="CompleteQuest('demo_GetSinks_Quest');  TActivate ('TriggerReturnToOldMan');  TActivate ('TriggerUnrealOldMan');  ShowCircleOnMinimap( 'demo', CVector(2801.324, 216.000, 3640.781), 100 );  local FVehicle0 = GetEntityByName('SinksRuner_vehicle_0');  if FVehicle0 then FVehicle0:Remove() end;  EndConversation()" />

	<Reply
		name="Dlg_pl_000173"
		text="Share your troubles with me. What’s troubling you?"
		role="PLAYER"
		nextReplies="Dlg_npc_000175" />

	<Reply
		name="Dlg_npc_000175"
		text="Do you really want to help? Then hear my story: voices called me to witness a miracle! I saw a rainbow streaking the sky with fiery bands. When the haze cleared, the city shone with unearthly colors. I haven’t fully grasped the meaning of this sign yet…"
		role="NPC"
		nextReplies="Dlg_pl_000177" />

	<Reply
		name="Sinks_hellodlg1"
		text="Damn old man, are you chasing me again!"
		role="NPC"
		scriptCondition="IsQuestTaken('demo_GetKey_Quest')   and   not(IsQuestComplete('demo_GetKey_Quest'))"
		nextReplies="Dlg_pl_000192" />

	<Reply
		name="Dlg_pl_000192"
		text="You’re definitely crazy! Open your eyes – what old man am I to you?!"
		role="PLAYER"
		nextReplies="Dlg_npc_000193" />

	<Reply
		name="Dlg_npc_000193"
		text="Now I see. But you can’t escape him anywhere! He lives by the sea and plots his schemes there! Watch out for him!"
		role="NPC"
		nextReplies="Dlg_pl_000194" />

	<Reply
		name="Dlg_pl_000194"
		text="I just need to get into the locked warehouse, and you happen to be driving around nearby. Do you know who has the key?"
		role="PLAYER"
		nextReplies="Dlg_npc_000083" />

	<Reply
		name="Dlg_npc_000083"
		text="A key? This one? Take it. Just promise me you’ll leave soon – for your own safety."
		role="NPC"
		nextReplies="Dlg_pl_000084" />

	<Reply
		name="Dlg_pl_000084"
		text="Well, I can’t promise that. First I’ll check out the warehouse, then I’ll stop by to ask a few questions of an acquaintance."
		role="PLAYER"
		scriptResult="CompleteQuest('demo_GetKey_Quest');  TActivate ('TriggerSkladGun');  local FVehicle0 = GetEntityByName('SinksRuner_vehicle_0');  if FVehicle0 then FVehicle0:Remove() end;  EndConversation()" />
<!--Root/demo/Сюжетные/Иери у самолета-->
	<Reply
		name="Dlg_npc_000131"
		text="You’re right about that. I’ve been watching you ever since you set foot on my land. Everyone you’ve spoken to here are my helpers – people who owe me a great deal. The churchmen want to destroy me because I promise people freedom. You yourself can break free from all earthly ties. I can see how your existence weighs you down. Follow me, and you’ll find freedom."
		role="NPC"
		nextReplies="Dlg_pl_000183 Dlg_pl_000184" />

	<Reply
		name="Dlg_pl_000184"
		text="Duty comes first! I owe too much to my clan to betray it. You must die."
		role="PLAYER"
		nextReplies="Dlg_npc_000185" />

	<Reply
		name="Dlg_npc_000185"
		text="You’re a free man, and you alone can choose your fate. But I will fight."
		role="NPC"
		nextReplies="Dlg_pl_000186" />

	<Reply
		name="Dlg_pl_000186"
		text="I don’t care."
		role="PLAYER"
		scriptResult="CompleteQuest('demo_MoveToIeri_Quest');  TActivate ('TriggerKillIeri');  TDeactivate('TriggerMorrasTrue1');  TDeactivate('TriggerMorrasTrue2');  EndConversation()" />

	<Reply
		name="Dlg_pl_000183"
		text="All my life I’ve made mistakes… Now it’s time to fix them. I’ll follow you."
		role="PLAYER"
		nextReplies="Dlg_npc_000187" />

	<Reply
		name="Dlg_npc_000187"
		text="You have great strength of spirit – together we can achieve much… Wait… What is this? I sense many enemies approaching!"
		role="NPC"
		nextReplies="Dlg_pl_000188" />

	<Reply
		name="Dlg_pl_000188"
		text="There’s no escape for you. Bounty hunters are a fearsome foe. Even if we defeat them, others will take their place."
		role="PLAYER"
		nextReplies="Dlg_npc_000189" />

	<Reply
		name="Dlg_npc_000189"
		text="Then it’s time to leave. Thanks to you, I’ve regained my faith in humanity. But I need time – until the ship arrives."
		role="NPC"
		nextReplies="Dlg_pl_000190" />

	<Reply
		name="Dlg_pl_000190"
		text="I’ll give you that time!"
		role="PLAYER"
		scriptResult="CompleteQuest('demo_MoveToIeri_Quest');  FailQuest('demo_KillMan_Quest');  TakeQuest('demo_DefendIeri_Quest');  TActivate ('TriggerDefendIeri');  TDeactivate('TriggerMorrasTrue1');  TDeactivate('TriggerMorrasTrue2');  EndConversation()" />

	<Reply
		name="RealIeri_hellodlg0"
		text="I take it you have many questions for me. Ask – I’ll answer them all."
		role="NPC"
		scriptCondition="IsQuestTaken('demo_MoveToIeri_Quest')     and     not(IsQuestComplete('demo_MoveToIeri_Quest')) "
		nextReplies="Dlg_pl_000128 Dlg_pl_000129" />

	<Reply
		name="Dlg_pl_000129"
		text="I have no questions for you, old man. I must complete my mission – and you must die."
		role="PLAYER"
		nextReplies="Dlg_npc_000185" />

	<Reply
		name="Dlg_pl_000128"
		text="What happened in the dead city? Was it your doing?"
		role="PLAYER"
		nextReplies="Dlg_npc_000130" />

	<Reply
		name="Dlg_npc_000130"
		text="No, I’m not involved in what’s happening there. The Ghost City is a trap for careless travelers. I don’t know what happened there in the past, but it’s been like that for many years. I merely used it to get rid of those who wanted to kill me."
		role="NPC"
		nextReplies="Dlg_pl_000131" />

	<Reply
		name="Dlg_pl_000131"
		text="Hmm… Alright, let’s say I believe you. But everything else around here was your doing, wasn’t it?"
		role="PLAYER"
		nextReplies="Dlg_npc_000131" />
</DialogsResource>
