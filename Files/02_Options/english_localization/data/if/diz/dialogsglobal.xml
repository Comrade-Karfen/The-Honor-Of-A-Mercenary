		text="I’m looking for a man named Ieri."
		role="PLAYER"
		nextReplies="RandomBar_npc_000091" />

	<Reply
		name="RandomBar_npc_000091"
		text="I don’t know such a person."
		role="NPC"
		nextReplies="RandomBar_pl_000092" />

	<Reply
